{
  "name": "designerbook",
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.6",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v",
    "docker:infra:up": "docker compose -f docker-compose.infra.yml up --build",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down -v",
    "docker:prod:up": "docker compose up --build -d",
    "docker:prod:down": "docker compose down -v"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
